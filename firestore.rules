rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Authenticated users may read only their own profile. Profiles cannot be edited from the client.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Schools collection (multi-tenant management)
    match /schools/{schoolId} {
      allow read: if isValidId(schoolId);
      allow create, update: if isValidId(schoolId);
      allow delete: if isValidId(schoolId);
    }

    // Students collection
    match /students/{studentId} {
      allow read: if isValidId(studentId);
      allow create, update: if isValidId(studentId);
      allow delete: if isValidId(studentId);
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isValidId(groupId);
      allow create, update: if isValidId(groupId);
      allow delete: if isValidId(groupId);
    }

    // Disputes collection
    match /disputes/{disputeId} {
      allow read: if isValidId(disputeId);
      allow create, update: if isValidId(disputeId);
      allow delete: if isValidId(disputeId);
    }

    // Audit logs collection (immutable records)
    match /audit_logs/{auditId} {
      allow read: if isValidId(auditId);
      allow create: if isValidId(auditId);
      allow update, delete: if false; // Immutable audit trail
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isValidId(notificationId);
      allow create, update: if isValidId(notificationId);
      allow delete: if isValidId(notificationId);
    }

  }
}
