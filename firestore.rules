rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.uid == 'HHqtnrIQ9uZHkL16GBCzsWT7Jkr2'
        && request.auth.token.email == 'sarsjs@gmail.com';
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return hasProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // A user can read only their own profile. Superadmin can manage profiles.
    // The first owner profile is created manually in Firebase Console; this avoids
    // letting an unauthorised client self-assign an elevated role.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isSuperAdmin()
        || (isBootstrapAdmin()
          && userId == request.auth.uid
          && request.resource.data.role == 'superadmin'
          && request.resource.data.email == request.auth.token.email);
      allow delete: if isSuperAdmin() && userId != request.auth.uid;
    }

    // Temporary initial rollout policy: only the verified superadmin may access
    // school data until role- and school-scoped permissions are implemented.
    match /schools/{schoolId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /students/{studentId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /groups/{groupId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /disputes/{disputeId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    // Audit records may be created/read by superadmin only and are immutable.
    match /audit_logs/{auditId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    // Connectivity probe: authenticated sessions only; no public reads/writes.
    match /test/{testId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Default deny for every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
