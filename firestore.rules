rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.uid == 'HHqtnrIQ9uZHkL16GBCzsWT7Jkr2'
        && request.auth.token.email == 'sarsjs@gmail.com';
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return hasProfile() && profile().role == 'superadmin';
    }

    function hasSchoolStaffRole() {
      return hasProfile()
        && profile().role in ['director', 'orientador', 'teacher'];
    }

    function canAccessSchool(schoolId) {
      return hasSchoolStaffRole()
        && profile().schoolId == schoolId;
    }

    function isOwnStudent(studentId) {
      return hasProfile()
        && profile().role == 'student'
        && profile().linkedEntityId == studentId;
    }

    function canReadAssignedGroup(groupId) {
      return hasProfile()
        && profile().role == 'student'
        && profile().linkedEntityId is string
        && exists(/databases/$(database)/documents/students/$(profile().linkedEntityId))
        && get(/databases/$(database)/documents/students/$(profile().linkedEntityId)).data.groupId == groupId;
    }

    function canManageGroups(schoolId) {
      return isSuperAdmin()
        || (canAccessSchool(schoolId)
          && profile().role in ['director', 'orientador']);
    }

    function canManageStudents(schoolId) {
      return isSuperAdmin()
        || (canAccessSchool(schoolId)
          && profile().role in ['director', 'orientador']);
    }

    // Users may read their own profile. Only the superadmin may provision or
    // change other profiles; the initial owner bootstrap is narrowly constrained.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isSuperAdmin()
        || (isBootstrapAdmin()
          && userId == request.auth.uid
          && request.resource.data.role == 'superadmin'
          && request.resource.data.email == request.auth.token.email);
      allow delete: if isSuperAdmin() && userId != request.auth.uid;
    }

    // School users can read only their own school record.
    match /schools/{schoolId} {
      allow read: if isSuperAdmin() || (hasProfile() && profile().schoolId == schoolId);
      allow create, update, delete: if isSuperAdmin();
    }

    // Every student/group record must carry schoolId to be accessible by school staff.
    match /students/{studentId} {
      allow read: if isSuperAdmin()
        || isOwnStudent(studentId)
        || (resource.data.schoolId is string && canAccessSchool(resource.data.schoolId));
      allow create: if isSuperAdmin()
        || (request.resource.data.schoolId is string
          && canManageStudents(request.resource.data.schoolId));
      // Students can read their own enrollment but cannot update attendance,
      // location, ETA, or validation fields directly from the client.
      allow update: if isSuperAdmin()
        || (resource.data.schoolId is string
          && request.resource.data.schoolId == resource.data.schoolId
          && canManageStudents(resource.data.schoolId));
      allow delete: if isSuperAdmin()
        || (resource.data.schoolId is string
          && canAccessSchool(resource.data.schoolId)
          && profile().role == 'director');
    }

    match /groups/{groupId} {
      allow read: if isSuperAdmin()
        || canReadAssignedGroup(groupId)
        || (resource.data.schoolId is string && canAccessSchool(resource.data.schoolId));
      allow create: if request.resource.data.schoolId is string
        && canManageGroups(request.resource.data.schoolId);
      allow update: if isSuperAdmin()
        || (resource.data.schoolId is string
          && request.resource.data.schoolId == resource.data.schoolId
          && canManageGroups(resource.data.schoolId));
      allow delete: if isSuperAdmin()
        || (resource.data.schoolId is string
          && canAccessSchool(resource.data.schoolId)
          && profile().role == 'director');
    }

    match /disputes/{disputeId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /audit_logs/{auditId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /test/{testId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
